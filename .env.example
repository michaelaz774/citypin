# Frontend (Vite) — copied into the client bundle at build time
# Google Map Tiles API key for the photorealistic layer. Empty = the free OpenStreetMap city.
VITE_GOOGLE_MAPS_API_KEY=
# Relay websocket (default: ws://<host>:8790). Production: wss://5-161-53-64.sslip.io
VITE_WS_URL=
# Bump to bust the cached city data file
VITE_DATA_VERSION=4

# Relay (node server/index.mjs) — set in deploy/relay.service in production
# PINS_PATH=/var/lib/citypin/pins.json   where pins are persisted (outside the deploy dir so redeploys keep them)
# ALLOWED_ORIGINS=https://citypin.pages.dev,.citypin.pages.dev
